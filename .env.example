APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentrunnerv2
AGENT_RUNNER_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentrunnerv2
AGENT_RUNNER_TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentrunnerv2
API_HOST=0.0.0.0
API_PORT=8200

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS
# Include localhost, 127.0.0.1, and your static IP for local network testing
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://192.168.0.200:5173","http://192.168.0.200:3000"]
